<!--
  Replan only when the untraversed portion of the Global Path becomes invalid.
  Humble PlannerServer IsPathValid starts its lethal check at the closest path
  point to the robot. The 10 Hz guard never republishes a valid Global Path.
  Invalidity must persist 300 ms before replanning; RPP handles immediate
  collision avoidance independently. Do not run Spin/BackUp recovery.
  The backend still owns the 5-second no-progress and STOP watchdog.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="5" name="NavigateWithBoundedRecovery">
      <PipelineSequence name="NavigateOnValidatedPath">
        <RateController hz="10.0">
          <Fallback name="ReuseValidPath">
            <IsPathValid path="{path}" server_timeout="100"/>
            <Delay delay_msec="300">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            </Delay>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath"/>
      </PipelineSequence>
      <Delay delay_msec="500">
        <AlwaysSuccess/>
      </Delay>
    </RecoveryNode>
  </BehaviorTree>
</root>
