<!--
  ROS2 Humble / BehaviorTree.CPP v3:
  - Compute the initial path immediately, before IsPathValid can inspect it.
  - On 10Hz ticks reuse a valid path without re-publishing/re-planning.
  - During a sustained invalid path, a ReactiveSequence continuously checks
    invalidity and halts the Delay whenever validity is restored.
  - Only if invalidity continues for >=300ms is ComputePathToPose re-run.
  - The controller is responsible for immediate local collision-stop behavior.
  - Recovery is bounded; no blind Spin/BackUp recovery is authorized.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="5" name="NavigateWithBoundedRecovery">
      <Sequence name="NavigateWithInitialPlan">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
        <PipelineSequence name="NavigateOnValidatedPath">
          <RateController hz="10.0">
            <Fallback name="ReuseOrReplanPath">
              <IsPathValid path="{path}" server_timeout="100"/>
              <ReactiveSequence name="WaitForSustainedInvalidPath">
                <Inverter>
                  <IsPathValid path="{path}" server_timeout="100"/>
                </Inverter>
                <Delay delay_msec="300">
                  <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </Delay>
              </ReactiveSequence>
            </Fallback>
          </RateController>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </PipelineSequence>
      </Sequence>
      <Delay delay_msec="500">
        <AlwaysSuccess/>
      </Delay>
    </RecoveryNode>
  </BehaviorTree>
</root>
