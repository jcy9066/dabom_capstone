<!--
  Nav2 Humble continuous A/B loop route:
  * Intermediate poses are considered passed at XY distance <= 0.50m.
    The loop-specific final goal checker uses relaxed xy/yaw tolerances.
    Rolling preemption occurs before reaching this final pose.
  * Initial path is computed once before validity checks.
  * Valid Global Path is reused at 10Hz. If changed Goals or invalidity is detected,
    at most 5 planner retries within a 5s deadline are permitted.
  * No autonomous blind Spin, BackUp or costmap-clearing recovery.
  * The existing FollowPath controller executes reverse/pivot segments.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateThroughOrderedWaypoints">
      <Timeout msec="5000">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
      </Timeout>
      <PipelineSequence name="NavigateOnValidatedWaypointPath">
        <RateController hz="10.0">
          <Fallback name="ReuseOrReplanWaypointPath">
            <Sequence name="ReuseValidUnchangedLoopPath">
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.50"/>
              <IsPathValid path="{path}" server_timeout="100"/>
              <!-- A new rolling Nav2 Goal must extend the cached path. -->
              <Inverter><GoalUpdated/></Inverter>
            </Sequence>
            <Timeout msec="5000">
              <RetryUntilSuccessful num_attempts="5">
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              </RetryUntilSuccessful>
            </Timeout>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="loop_goal_checker"/>
      </PipelineSequence>
    </Sequence>
  </BehaviorTree>
</root>
