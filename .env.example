# Raspberry Pi motor and command client
# Keep disabled until dry-run, localization, Nav2, E-stop and watchdog validation pass.
MOTOR_OUTPUT_ENABLED=false
MOTOR_SERIAL_PORT=
MOTOR_SERIAL_BAUDRATE=
MOTOR_SERIAL_TIMEOUT_SEC=
MAX_WHEEL_MPS=
COMMAND_TIMEOUT_SEC=
STATUS_INTERVAL_SEC=
STATUS_REQUEST_TIMEOUT_SEC=
WS_RECONNECT_DELAY_SEC=
ENCODER_INTERVAL_SEC=
ROBOT_COMMAND_ACK_TIMEOUT_SEC=

# ROS and LiDAR
ROS_DOMAIN_ID=
# Final Pi/GPU architecture transports sensors over WebSocket. Cross-host DDS is forbidden.
ROS_LOCALHOST_ONLY=1
LIDAR_ENABLE=
LIDAR_ROS_TOPIC=/scan
LIDAR_SCAN_TOPIC=/scan
LIDAR_BASE_FRAME=base_link
LIDAR_FRAME=laser
LIDAR_X=
LIDAR_Y=
LIDAR_Z=
LIDAR_ROLL=
LIDAR_PITCH=
LIDAR_YAW=
LIDAR_DASHBOARD_MAX_POINTS=
LIDAR_USE_SOURCE_TIMESTAMP=
LIDAR_WS_RECONNECT_SEC=
LIDAR_SERIAL_PORT=
LIDAR_SERIAL_BAUDRATE=
LIDAR_DRIVER_PACKAGE=
LIDAR_DRIVER_EXECUTABLE=

# Encoder and odometry
ENCODER_ROS_ENABLE=true
# These two topics must remain identical: bridge output -> wheel odometry input.
ENCODER_ROS_TOPIC=/wheel_ticks
WHEEL_DIAMETER_M=
WHEEL_TRACK_M=
ENCODER_TICKS_PER_REV=
WHEEL_TICKS_TOPIC=/wheel_ticks
ODOM_TOPIC=/odom
ODOM_FRAME=odom
BASE_FRAME=base_link
ODOMETRY_ENCODER_TIMEOUT_SEC=

# Navigation and watchdog
NAV_DRY_RUN_ENABLED=true
NAVIGATION_TIMEOUT_SEC=
NAVIGATION_DEFAULT_MODE=
NAV_SCAN_TIMEOUT_SEC=
NAV_STOP_DISTANCE_M=
NAV_SLOW_DISTANCE_M=
NAV_NORMAL_LINEAR_MPS=
NAV_SLOW_LINEAR_MPS=
NAV_TURN_ANGULAR_RPS=
NAV_PROCESS_START_TIMEOUT_SEC=
NAV_PROCESS_STOP_TIMEOUT_SEC=
NAV_DRIVING_READY_TIMEOUT_SEC=
DASHBOARD_ESTOP_COOLDOWN_SEC=
DASHBOARD_GOAL_REACHED_TOLERANCE_M=
NAV_COMPUTE_PATH_TIMEOUT_SEC=
NAV_CANCEL_TIMEOUT_SEC=
NAV_CANCEL_RESULT_TIMEOUT_SEC=
NAV_WATCHDOG_INTERVAL_SEC=
NAV_WATCHDOG_LIDAR_TIMEOUT_SEC=
NAV_WATCHDOG_ODOM_TIMEOUT_SEC=
NAV_WATCHDOG_TF_TIMEOUT_SEC=
NAV_WATCHDOG_TF_SOURCE_MAX_AGE_SEC=
