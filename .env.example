# Raspberry Pi motor and command client
# Keep disabled until dry-run, localization, Nav2, E-stop and watchdog validation pass.
MOTOR_OUTPUT_ENABLED=
MOTOR_SERIAL_PORT=
MOTOR_SERIAL_BAUDRATE=
MOTOR_SERIAL_TIMEOUT_SEC=
# Full-PWM wheel speed (m/s), SAME on GPU server and Pi.
# 0.212 is the theoretical upper bound for 60 RPM and a 67.5 mm wheel:
# pi * 0.0675 m * 1 rev/s ~= 0.212 m/s. It is NOT a measured loaded speed.
# Start from this upper bound, then reduce BOTH hosts after encoder/road testing.
MAX_WHEEL_MPS=0.212
# Minimum normalized PWM for non-zero autonomous motor commands.
MIN_AUTO_DRIVE_PWM=0.30
COMMAND_TIMEOUT_SEC=
STATUS_INTERVAL_SEC=
STATUS_REQUEST_TIMEOUT_SEC=
WS_RECONNECT_DELAY_SEC=
ENCODER_INTERVAL_SEC=
ROBOT_COMMAND_ACK_TIMEOUT_SEC=

# ROS and LiDAR
ROS_DOMAIN_ID=
# Final Pi/GPU architecture transports sensors over WebSocket. Cross-host DDS is forbidden.
ROS_LOCALHOST_ONLY=
LIDAR_ENABLE=
LIDAR_ROS_TOPIC=
LIDAR_SCAN_TOPIC=
LIDAR_BASE_FRAME=
LIDAR_FRAME=
LIDAR_X=
LIDAR_Y=
LIDAR_Z=
LIDAR_ROLL=
LIDAR_PITCH=
# Physical LiDAR mount yaw relative to base_link (+Z), radians.
LIDAR_YAW=3.141592653589793
LIDAR_DASHBOARD_MAX_POINTS=
LIDAR_USE_SOURCE_TIMESTAMP=
LIDAR_WS_RECONNECT_SEC=
LIDAR_SCAN_STALE_SEC=3.0
LIDAR_SERIAL_PORT=
LIDAR_SERIAL_BAUDRATE=
LIDAR_DRIVER_PACKAGE=
LIDAR_DRIVER_EXECUTABLE=

