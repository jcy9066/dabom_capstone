ACTION_MIN_HISTORY_FRAMES=12
# Max center distance / person height for two-person interaction pairing.
ACTION_INTERACTION_PAIR_DISTANCE_RATIO=1.5
# Run pair inference every N processed frames; cached pair state is reused between runs.
ACTION_INTERACTION_INFER_EVERY_N=2
ACTION_DISPLAY_TTL_SEC=
TRIGGER_SUSPICIOUS_VISUAL_ENABLED=
INFERENCE_MAX_RESULT_AGE_SEC=
INFERENCE_DROP_OLDER_THAN_SEC=
CUDA_DEVICE_INDEX=
DEVICE=
